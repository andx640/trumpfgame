<!DOCTYPE html>
<html>
<head>
  <meta charset="UTF-8">
  <title>Trumpf-Kartenspiel Lobby</title>
</head>
<body>

<h2>Trumpf-Kartenspiel Lobby</h2>

<div id="lobby">
  <input id="nameInput" placeholder="Name">
  <button onclick="joinLobby()">Beitreten</button>
  <ul id="playerList"></ul>
  <button id="startBtn" onclick="startGame()" style="display:none;">Start Spiel</button>
</div>

<div id="gameArea" style="display:none;">
  <h3>Deine Karten:</h3>
  <div id="playerCards"></div>
</div>

<script src="https://cdn.socket.io/4.7.2/socket.io.min.js"></script>
<script>
const socket = io("http://localhost:3000");

function joinLobby() {
  const name = document.getElementById("nameInput").value;
  if (!name) return alert("Bitte Namen eingeben!");
  socket.emit("joinLobby", name);
}

function startGame() {
  socket.emit("startGame");
}

// Lobby-Update
socket.on("lobbyUpdate", (players) => {
  const list = document.getElementById("playerList");
  list.innerHTML = "";
  players.forEach(p => {
    const li = document.createElement("li");
    li.textContent = p.name + (p.isHost ? " (Host)" : "");
    list.appendChild(li);
  });

  // Start-Button nur für Host sichtbar
  const isHost = players.some(p => p.isHost && p.id === socket.id);
  document.getElementById("startBtn").style.display = isHost ? "block" : "none";
});

// Spielstart
socket.on("gameStarted", (hand) => {
  document.getElementById("lobby").style.display = "none";
  document.getElementById("gameArea").style.display = "block";

  const cardsDiv = document.getElementById("playerCards");
  cardsDiv.innerHTML = "";
  hand.forEach(card => {
    const btn = document.createElement("button");
    btn.textContent = card.name + " (" + card.leistung + " PS)";
    cardsDiv.appendChild(btn);
  });
});
</script>

</body>
</html>


