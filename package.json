{
  "name": "trumpfgame",
  "version": "2.0.0",
  "private": true,
  "description": "Mehrspieler-Autoquartett mit React (Frontend) und PHP (Spiel-API)",
  "scripts": {
    "dev": "concurrently -k -n api,web -c yellow,cyan \"php -S localhost:8080 -t .\" \"vite\"",
    "build": "vite build",
    "images:metadata": "node scripts/fetch-card-images.js",
    "images:update": "node scripts/fetch-card-images.js && node scripts/download-card-images.js",
    "test": "php test/api-test.php"
  },
  "dependencies": {
    "@fontsource/barlow": "^5.3.0",
    "@fontsource/barlow-condensed": "^5.3.0",
    "react": "^19.1.1",
    "react-dom": "^19.1.1"
  },
  "devDependencies": {
    "@vitejs/plugin-react": "^4.7.0",
    "concurrently": "^9.2.1",
    "vite": "^7.1.3"
  }
}
