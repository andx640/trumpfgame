# Spiellogik, Konten und Zugangsdaten werden nur von index.php eingebunden, nicht direkt aufgerufen.
<FilesMatch "^(engine|accounts|config)\.php$">
  <IfModule mod_authz_core.c>
    Require all denied
  </IfModule>
  <IfModule !mod_authz_core.c>
    Order deny,allow
    Deny from all
  </IfModule>
</FilesMatch>
