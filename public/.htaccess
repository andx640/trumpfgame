# Startseite, Versionsdatei und Service Worker nie zwischenspeichern, damit neue Versionen sofort ankommen.
<IfModule mod_headers.c>
  <FilesMatch "(\.html|sw\.js|version\.json|site\.webmanifest)$">
    Header set Cache-Control "no-cache, no-store, must-revalidate"
    Header set Pragma "no-cache"
    Header set Expires "0"
  </FilesMatch>
  # Dateien in /assets haben einen Hash im Namen und ändern sich nie
  <FilesMatch "\.[0-9A-Za-z_-]{8}\.(js|css|woff2?)$">
    Header set Cache-Control "public, max-age=31536000, immutable"
  </FilesMatch>
</IfModule>
<IfModule mod_expires.c>
  ExpiresActive On
  ExpiresByType text/html "access plus 0 seconds"
  ExpiresByType application/json "access plus 0 seconds"
</IfModule>
